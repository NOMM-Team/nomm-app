pkgname=nomm-git
pkgrel=1
_pkgbase=0.12.4
pkgver=0.12.2.c844
pkgdesc="Native Open Mod Manager - a mod manager for Linux"
arch=('any')
url="https://github.com/Allexio/nomm"
license=('GPL3')
depends=(
    'python'
    'python-gobject'
    'gtk4'
    'libadwaita'
    'python-requests'
    'python-yaml'
    'p7zip'
    'unrar'
    'python-vdf'
    'python-rarfile'
)
makedepends=(
    'gettext'
    'git'
)
source=("git+https://github.com/Allexio/nomm.git#branch=main")
sha256sums=('SKIP')

pkgver() {
    cd "nomm"
    printf "%s.c%s" "$_pkgbase" "$(git rev-list --count HEAD)"
}

package() {
    cd "nomm"

    # App files
    install -dm755 "$pkgdir/usr/lib/nomm"
    cp -r src/* "$pkgdir/usr/lib/nomm/"
    cp -r assets default_game_configs "$pkgdir/usr/lib/nomm/"

    # Entry point
    install -dm755 "$pkgdir/usr/bin"
    cat > "$pkgdir/usr/bin/nomm" <<'EOF'
#!/bin/sh
exec python3 /usr/lib/nomm/main.py "$@"
EOF
    chmod 755 "$pkgdir/usr/bin/nomm"

    # Desktop file
    install -Dm644 build/flatpak/moe.nomm.Nomm.desktop \
        "$pkgdir/usr/share/applications/moe.nomm.Nomm.desktop"

    # Icon
    install -Dm644 assets/icons/nomm-logo.svg \
        "$pkgdir/usr/share/icons/hicolor/64x64/apps/moe.nomm.Nomm.svg"

    # Localisation
    install -dm755 "$pkgdir/usr/share/locale/fr/LC_MESSAGES"
    msgfmt locale/fr.po -o "$pkgdir/usr/share/locale/fr/LC_MESSAGES/moe.nomm.Nomm.mo"
}
